{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-gate.sh check",
            "timeout": 15,
            "statusMessage": "Commit gate: checking skill passes"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/waiver-gate.sh edit",
            "timeout": 10,
            "statusMessage": "Waiver gate: checking for a new lint/security suppression"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-gate.sh post-commit",
            "timeout": 15,
            "statusMessage": "Commit gate: checking whether a mutation pass is due"
          }
        ]
      }
    ]
  }
}
